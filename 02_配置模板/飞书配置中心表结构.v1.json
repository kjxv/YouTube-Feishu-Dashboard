{
  "schema_version": 1,
  "说明": "本文件供人工查看；程序使用公共包内同版结构自动创建四张表。字段类型代码：1=单行文本，3=单选，7=复选框。敏感凭证不得写入这些表。",
  "tables": [
    {
      "name": "API字段字典",
      "主字段": "标准字段ID",
      "其他字段": ["中文名称", "API来源", "官方字段", "数据类型", "单位", "数据层级", "查询组", "启用", "目录版本"],
      "数据来源": "系统内置版本化 API 字段能力目录"
    },
    {
      "name": "模块字段需求与映射",
      "主字段": "模块ID",
      "其他字段": ["标准字段ID", "飞书列名", "目标表ID", "启用"],
      "说明": "按模块ID+标准字段ID识别记录；初始写入最新视频实时快照表的实际列名"
    },
    {
      "name": "数据项目配置",
      "主字段": "配置键",
      "其他字段": ["配置值", "启用"],
      "初始配置": {"latest_interval_minutes": "60", "latest_tracking_days": "28"}
    },
    {
      "name": "账号非敏感配置",
      "主字段": "配置键",
      "其他字段": ["配置值", "启用"],
      "初始配置": {"youtube_channel_id": "可留空自动识别", "latest_video_table_id": "从 .env 读取"}
    }
  ]
}
