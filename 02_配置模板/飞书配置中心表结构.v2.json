    "数据项目配置": ["配置键", "中文配置名", "配置值", "值类型", "单位", "允许范围或格式", "作用说明", "生效模块", "实现状态", "启用"],
    "账号非敏感配置": ["配置键", "中文配置名", "配置值", "用途说明", "获取方式", "是否必填", "生效模块", "实现状态", "启用"]
