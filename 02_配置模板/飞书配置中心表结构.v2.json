    "模块字段需求与映射": ["模块ID", "目标表ID", "飞书列名", "标准字段ID", "启用"],
    "数据项目配置": ["配置键", "配置值", "启用"],
    "账号非敏感配置": ["配置键", "配置值", "启用"]
  },
  "tables": {
