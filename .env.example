# 复制为 .env 后填写。不要把 .env、OAuth 文件或 Token 提交到 Git。

# 运行环境：development / production / test
YFD_ENVIRONMENT=development
YFD_TIMEZONE=Asia/Shanghai
YFD_LOG_LEVEL=INFO

# V1 默认 SQLite。VPS 使用 PostgreSQL 时改成：
# postgresql+psycopg://用户名:密码@数据库主机:5432/数据库名
YFD_DATABASE_URL=sqlite:///data/yfd.db

# YouTube OAuth 文件路径（相对路径以仓库根目录为基准）
YFD_YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YFD_YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YFD_YOUTUBE_CHANNEL_ID=

# 飞书企业自建应用凭证（敏感）
YFD_FEISHU_APP_ID=
YFD_FEISHU_APP_SECRET=
# 国内飞书默认值如下；Lark 国际版改为 https://open.larksuite.com/open-apis
YFD_FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# 飞书多维表格引导配置。表格里的非敏感配置加载成功后会进入公共配置缓存。
YFD_FEISHU_BASE_TOKEN=
YFD_FEISHU_API_FIELD_TABLE_ID=
YFD_FEISHU_MODULE_MAPPING_TABLE_ID=
YFD_FEISHU_PROJECT_CONFIG_TABLE_ID=
YFD_FEISHU_ACCOUNT_CONFIG_TABLE_ID=
# 三张业务表使用明确名称；旧版 YFD_FEISHU_LATEST_VIDEO_TABLE_ID 仅作兼容回退
YFD_FEISHU_LATEST_VIDEO_MAIN_TABLE_ID=
YFD_FEISHU_LATEST_VIDEO_SNAPSHOT_TABLE_ID=
YFD_FEISHU_LATEST_VIDEO_COMPARISON_TABLE_ID=
YFD_FEISHU_LATEST_VIDEO_TABLE_ID=

# 调度默认值可由飞书“数据项目配置”覆盖
YFD_LATEST_INTERVAL_MINUTES=60
YFD_LATEST_ANALYTICS_INTERVAL_HOURS=24
YFD_LATEST_REPORTING_INTERVAL_HOURS=6
YFD_LATEST_TRACKING_DAYS=28
YFD_LATEST_HOURLY_TRACKING_HOURS=72
YFD_LATEST_DAILY_COLLECTION_HOUR=8
YFD_SCHEDULER_LOCK_TTL_SECONDS=900
YFD_CONFIG_CACHE_TTL_MINUTES=1440
YFD_FEISHU_ARCHIVE_ROW_THRESHOLD=19000

# 可选网络代理，例如 http://127.0.0.1:10808；VPS 通常留空
YFD_HTTPS_PROXY=
